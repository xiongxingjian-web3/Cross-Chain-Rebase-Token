# =============================================================================
# 根目录 .gitignore — 跨链 Rebase Token  monorepo
# 提交前请确认：git status 中不应出现 .env、私钥、broadcast 等
# =============================================================================

# --- 敏感信息（切勿提交）---
.env
.env.*
!.env.example
!ccip-rebase-token/.env.example
!ccip-rebase-token-ui/.env.example
*.pem
*.key
*.keystore
**/secrets.json
**/credentials.json
**/mnemonic.txt
**/*_private_key*
**/*private-key*

# --- Foundry / 合约 (ccip-rebase-token) ---
ccip-rebase-token/cache/
ccip-rebase-token/out/
ccip-rebase-token/zkout/
ccip-rebase-token/lib/
ccip-rebase-token/broadcast/
ccip-rebase-token/foundryup-zksync
ccip-rebase-token/remappings.txt
ccip-rebase-token/.env

# --- 前端 (ccip-rebase-token-ui) ---
ccip-rebase-token-ui/node_modules/
ccip-rebase-token-ui/.next/
ccip-rebase-token-ui/out/
ccip-rebase-token-ui/build/
ccip-rebase-token-ui/.vercel/
ccip-rebase-token-ui/.env
ccip-rebase-token-ui/.env.local
ccip-rebase-token-ui/.env.*.local
ccip-rebase-token-ui/coverage/
ccip-rebase-token-ui/*.tsbuildinfo
ccip-rebase-token-ui/.pnp
ccip-rebase-token-ui/.pnp.*

# --- 日志与调试 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini


# --- 旧路径占位（若曾用 frontend 目录名）---
frontend/node_modules/
frontend/.env
frontend/dist/
frontend/build/
