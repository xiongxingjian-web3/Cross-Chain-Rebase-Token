# 复制为 .env 后填入真实值，切勿将 .env 提交到 Git
# cp .env.example .env

# --- 用于发起交易的账户（必填，勿泄露）---
PRIVATE_KEY="your_private_key_without_0x_prefix"

# --- Arbitrum Sepolia（可选）---
ARBITRUM_SEPOLIA_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY"
ARBITRUM_SEPOLIA_EXPLORER_API_KEY="your_etherscan_api_key"

# --- 源链 Ethereum Sepolia ---
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
SEPOLIA_EXPLORER_API_KEY="your_etherscan_api_key"

# --- 目标链 ZKsync Sepolia ---
ZKSYNC_SEPOLIA_RPC_URL="https://zksync-sepolia.g.alchemy.com/v2/YOUR_KEY"
ZKSYNC_SEPOLIA_EXPLORER_API_KEY="your_zksync_explorer_api_key"

# --- 部署后填入合约地址（由 bridgeToZKsync.sh 输出）---
ZKSYNC_REBASE_TOKEN_ADDRESS=
ZKSYNC_POOL_ADDRESS=
SEPOLIA_REBASE_TOKEN_ADDRESS=
SEPOLIA_POOL_ADDRESS=
VAULT_ADDRESS=

# --- 可选：跳过部署步骤 ---
# SKIP_ZKSYNC_DEPLOY=1
# SKIP_SEPOLIA_DEPLOY=1
# SKIP_VAULT_DEPLOY=1
# SKIP_SEPOLIA_POOL_CONFIG=1
# SKIP_ZKSYNC_POOL_CONFIG=1
# SKIP_VAULT_DEPOSIT=1
# SKIP_BRIDGE=1
# SKIP_SEPOLIA_VERIFY=1
# SKIP_ZKSYNC_VERIFY=1
